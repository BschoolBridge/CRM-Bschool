# Required
# DATABASE_URL must be reachable during `npm run build` (migrate deploy runs there).
DATABASE_URL=mysql://crm:crm@127.0.0.1:3308/crm
SECRET_KEY=change-me-to-at-least-32-random-characters

# Local defaults (optional)
NODE_ENV=development
PORT=8000
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=Asia/Kolkata
# USE_HTTPS is optional: inferred from SITE_URL (https → on) or NODE_ENV (production → on).
# Set explicitly only when you need to override that.
# USE_HTTPS=false

# Website → CRM webhook (optional until you connect the site)
CRM_WEBHOOK_TOKEN=
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_ENABLED=
CRM_WEBHOOK_DEDUPE_PHONE=1
CRM_WEBHOOK_SOURCE_NAME=
CRM_WEBHOOK_URL=

# Production checklist (set on the server / host):
# NODE_ENV=production
# SITE_URL=https://your-crm.example.com
# SECRET_KEY=<32+ random chars>
# USE_HTTPS=true   # or omit when SITE_URL is https://
# TRUST_PROXY=true # only behind a reverse proxy that sets X-Forwarded-For
# Optional on small shared hosts if build OOMs:
# NODE_OPTIONS=--max-old-space-size=768
