{
  "name": "crm-portal",
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "prisma generate && next build --webpack",
    "start": "prisma migrate deploy && next start -p 8000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "mariadbd --datadir=.dev/mariadb --socket=.dev/mariadb.sock --port=3308",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create-superuser": "tsx scripts/create-superuser.ts",
    "data:import-django": "node --experimental-sqlite --import tsx scripts/import-django-data.ts"
  },
  "license": "UNLICENSED",
  "description": "CRM Portal (Next.js / MariaDB)",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/luxon": "^3.7.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "mariadb": "^3.5.4",
    "next": "^16.4.6",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
